{
  "name": "cubing-pro",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next out dist",
    "dev": "next dev",
    "howtocook:sync": "node scripts/sync-howtocook.mjs",
    "recipes:parse": "python3 scripts/parse_recipes.py",
    "tips:parse": "python3 scripts/parse_tips.py",
    "howtocook:parse": "npm run recipes:parse && npm run tips:parse",
    "howtocook:prepare": "node scripts/prepare-howtocook.mjs",
    "prebuild": "npm run howtocook:prepare",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "npx --yes serve@14 dist",
    "start": "next start",
    "test:algs": "node --test src/views/Algs/components/formulaPracticeTimer.test.mjs && tsx --test src/services/cubing-pro/algs/formulaPracticeHistory.test.mjs",
    "test:algs:browser": "node src/views/Algs/components/formulaPracticeTimer.browser.test.mjs",
    "test:algs:layout": "node src/views/Algs/components/algsLayout.browser.test.mjs",
    "test:puzzles": "node --test src/components/puzzles/model.test.mjs src/components/puzzles/practiceSetup.test.mjs src/components/puzzles/notation.test.mjs src/components/puzzles/cubeDiagrams.test.mjs src/components/puzzles/specialDiagrams.test.mjs src/views/Algs/utils/twoByTwoCategories.test.mjs",
    "test:puzzles:browser": "node src/components/puzzles/puzzleDiagram.browser.test.mjs",
    "test:two-solver": "tsx --test src/views/TwoSolver/engine/engine.test.ts src/views/TwoSolver/engine/catalog.test.ts src/views/TwoSolver/engine/ergonomics.test.ts src/views/TwoSolver/engine/cancellation.test.ts src/views/TwoSolver/engine/axisSearch.test.ts src/views/TwoSolver/engine/settings.test.ts src/views/TwoSolver/engine/scramble.test.ts src/views/TwoSolver/solutionFormat.test.ts src/views/TwoSolver/uiPractice.test.ts src/views/TwoSolver/practiceStats.test.ts",
    "two-solver:sync": "node scripts/sync-two-solver-data.mjs",
    "two-solver:prepare": "node scripts/prepare-two-scrambler.mjs",
    "test:two-solver:browser": "node src/views/TwoSolver/twoSolver.workbench.browser.test.mjs",
    "test:two-solver:practice": "node src/views/TwoSolver/twoSolver.practice.browser.test.mjs",
    "test:puzzles:native": "node src/components/puzzles/nativeTwoByTwo.regression.test.mjs",
    "test:static-export": "node --test src/lib/staticExportPaths.test.mjs scripts/static-export.test.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@chakra-ui/react": "^3.22.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-react": "^1.0.6",
    "antd": "^6.4.3",
    "axios": "^1.17.0",
    "classnames": "^2.5.1",
    "cstimer_module": "^0.1.5",
    "cubing": "0.63.3",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "file-saver": "^2.0.5",
    "flag-icons": "^7.5.0",
    "html2canvas": "^1.4.1",
    "next": "^15.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.6.0",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sr-visualizer": "^1.0.13",
    "three": "0.170.0",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/three": "^0.169.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.4",
    "fake-indexeddb": "^6.2.8",
    "less": "^4.6.4",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
